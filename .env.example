# Threads API 인증 정보
#
# 발급 절차:
# 1) https://developers.facebook.com/apps 에서 앱 생성 (또는 기존 앱 사용)
# 2) 앱에 "Threads" 제품(use case) 추가
# 3) Threads use case 설정에서 threads_basic, threads_content_publish 스코프로
#    사용자 액세스 토큰 발급 (Graph API Explorer 또는 OAuth 플로우 사용)
# 4) 발급받은 토큰으로 아래 호출해서 THREADS_USER_ID 확인:
#    curl "https://graph.threads.net/v1.0/me?fields=id,username&access_token=<TOKEN>"
#
# 참고: threads 단기 토큰은 유효기간이 짧음. 장기 토큰으로 교환 권장:
#    curl "https://graph.threads.net/v1.0/access_token?grant_type=th_exchange_token&client_secret=<APP_SECRET>&access_token=<SHORT_TOKEN>"
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# 카드뉴스 이미지를 공개 URL로 노출하기 위한 GitHub 저장소 정보
# (이 저장소 자체를 이미지 호스팅으로 사용 — public 저장소여야 raw.githubusercontent.com 접근 가능)
GITHUB_OWNER=we2share55-lang
GITHUB_REPO=myparang_marketing_threads
GITHUB_BRANCH=master
